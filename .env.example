DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Firebase Client
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin Authorization
ADMIN_EMAILS=

# Cloudinary CDN Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Resend Email Configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# PhonePe Payment Gateway (PG V2 Standard Checkout)
# Keep all credentials strictly server-side. Never use NEXT_PUBLIC_ for secrets.
PHONEPE_ENV=sandbox                           # "sandbox" or "production"
PHONEPE_CLIENT_ID=your_phonepe_client_id       # V2 Client ID from PhonePe Dashboard
PHONEPE_CLIENT_SECRET=your_phonepe_client_secret # V2 Client Secret from PhonePe Dashboard
PHONEPE_CLIENT_VERSION=1                      # Integer client version (typically 1)
PHONEPE_WEBHOOK_USERNAME=your_webhook_username # Configured in PhonePe Dashboard -> Webhook
PHONEPE_WEBHOOK_PASSWORD=your_webhook_password # Configured in PhonePe Dashboard -> Webhook
NEXT_PUBLIC_APP_URL=http://localhost:3000      # Public base URL for payment redirects
